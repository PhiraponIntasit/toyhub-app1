# Copy to .env and fill in.

# Postgres connection string. On Supabase use the connection pooler string
# (port 6543) — a serverless function opens a connection per invocation.
DATABASE_URL=postgres://toyhub:toyhub_dev@localhost:5432/toyhub

# TLS is used for anything that is not localhost. Set to 'on' or 'off' to
# override that guess.
# DATABASE_SSL=

# A throwaway database for `npm test` — the suite truncates every table, and
# refuses to run unless this is set.
TEST_DATABASE_URL=postgres://toyhub:toyhub_dev@localhost:5432/toyhub_test

# Long random string used to sign session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me

PORT=3000

# Stripe test-mode keys (free — create an account at https://dashboard.stripe.com/register,
# no business verification needed to use test mode). Both come from
# https://dashboard.stripe.com/test/apikeys
# Checkout works without these, but payment is disabled until they're set:
# the app shows "payment gateway not configured" instead of erroring.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
