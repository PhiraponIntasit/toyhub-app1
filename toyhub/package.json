{
  "name": "toyhub",
  "version": "1.0.0",
  "description": "A collectible-figure storefront: Express + PostgreSQL + Stripe, with a no-build-step frontend.",
  "main": "index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "migrate": "node server/migrate.js",
    "seed": "node server/seed.js",
    "setup": "node server/migrate.js && node server/seed.js",
    "test": "node --test --test-concurrency=1 \"test/**/*.test.js\""
  },
